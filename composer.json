{
    "name": "sentry/sentry-bref",
    "type": "library",
    "description": "Bref SDK for Sentry (https://sentry.io)",
    "keywords": [
        "sentry",
        "bref",
        "log",
        "logging",
        "error-monitoring",
        "error-handler",
        "crash-reporting",
        "crash-reports",
        "profiling",
        "tracing"
    ],
    "homepage": "https://sentry.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Sentry",
            "email": "accounts@sentry.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sentry\\Bref\\": "src/"
        },
        "files": [
            "src/init.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sentry\\Bref\\Test\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "bref/bref": "^3.0.4",
        "bref/logger": "^1 | ^2",
        "illuminate/support": "^7 | ^8 | ^9 | ^10 | ^11 | ^12 | ^13",
        "psr/http-server-middleware": "^1.0",
        "sentry/sentry": "^4.33",
        "symfony/http-foundation": "^4 | ^5 | ^6 | ^7 | ^8"
    },
    "require-dev": {
        "aws/aws-sdk-php": "^3",
        "bref/laravel-bridge": "^3",
        "laravel/laravel": "^7 | ^8 | ^9 | ^10 | ^11 | ^12 | ^13",
        "phpunit/phpunit": "^9",
        "phpstan/phpstan": "^2",
        "symfony/dependency-injection": "^4 | ^5 | ^6 | ^7 | ^8",
        "symfony/event-dispatcher": "^4 | ^5 | ^6 | ^7 | ^8",
        "symfony/http-kernel": "^4 | ^5 | ^6 | ^7 | ^8"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sentry\\Bref\\Laravel\\BrefSentryServiceProvider"
            ]
        }
    }
}
