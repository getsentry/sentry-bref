{
    "name": "sentry/sentry-bref",
    "type": "library",
    "description": "Bref SDK for Sentry (https://sentry.io)",
    "keywords": [
        "sentry",
        "bref",
        "log",
        "logging",
        "error-monitoring",
        "error-handler",
        "crash-reporting",
        "crash-reports",
        "profiling",
        "tracing"
    ],
    "homepage": "https://sentry.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Sentry",
            "email": "accounts@sentry.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sentry\\Bref\\": "src/"
        },
        "files": [
            "src/init.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sentry\\Bref\\Test\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "bref/bref": "^3.0.13",
        "bref/logger": "^1 | ^2",
        "psr/http-server-middleware": "^1.0",
        "sentry/sentry": "^4.33"
    },
    "require-dev": {
        "aws/aws-sdk-php": "^3",
        "bref/laravel-bridge": "^3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "laravel/framework": "^12 | ^13",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^9",
        "sentry/sentry-laravel": "^4.28",
        "symfony/dependency-injection": "^6.4 | ^7 | ^8",
        "symfony/event-dispatcher": "^6.4 | ^7 | ^8",
        "symfony/http-kernel": "^6.4 | ^7 | ^8"
    },
    "conflict": {
        "laravel/framework": "<12",
        "symfony/http-foundation": "<6.4",
        "symfony/http-kernel": "<6.4"
    },
    "suggest": {
        "sentry/sentry-laravel": "For Laravel applications: Lambda contexts and cold starts in Laravel's transactions",
        "sentry/sentry-symfony": "For Symfony applications: cold starts in Symfony's transactions"
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@phpstan",
            "@tests"
        ],
        "tests": "vendor/bin/phpunit",
        "cs-check": "vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
        "cs-fix": "vendor/bin/php-cs-fixer fix --verbose --diff",
        "phpstan": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sentry\\Bref\\Laravel\\BrefSentryServiceProvider"
            ]
        }
    }
}
