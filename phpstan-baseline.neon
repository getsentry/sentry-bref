			count: 1
			path: src/Bref/BrefSubscriber.php

		-
			message: '#^Parameter \#1 \$string of function urlencode expects string, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: src/LambdaContext.php

		-
			message: '#^Parameter \#1 \$tags of method Sentry\\Tracing\\SpanContext\:\:setTags\(\) expects array\<string, string\>, array\<string, mixed\> given\.$#'
			identifier: argument.type
			count: 2
			path: src/Bref/BrefSubscriber.php

